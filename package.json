    "@pdf-lib/fontkit": "^1.1.1",
    "eslint": "^10.1.0",
    "hostlocal": "^2.4.1",
    "pdf-lib": "^1.17.1",
    "peggy": "^5.1.0"
  },
  "packageManager": "pnpm@10.32.1",
